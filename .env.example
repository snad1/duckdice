# DuckDice AutoBot: Environment Variables
# Copy to .env and fill in your values

# DuckDice API key (from https://duckdice.io/settings)
DUCKDICE_API_KEY=

# Telegram Bot Token (from @BotFather)
# Your numeric Telegram id: the only account allowed to run owner commands
TG_OWNER_ID=
DUCKDICE_TG_TOKEN=

# Optional overrides
# DUCKDICE_API_BASE=https://duckdice.io/api
# DUCKDICE_DB_PATH=~/.duckdice_autobot.db
# DUCKDICE_CONFIG_PATH=~/.duckdice_autobot.json
# DUCKDICE_TG_DATA=~/.duckbot_tg
