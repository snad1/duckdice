# DuckDice Admin Web App — Configuration
# Copy to .env and customize

DUCKDICE_WEB_SECRET_KEY=change-me-to-a-random-64-char-string
DUCKDICE_WEB_ADMIN_USER=admin
DUCKDICE_WEB_ADMIN_PASS=changeme123
DUCKDICE_WEB_HOST=127.0.0.1
DUCKDICE_WEB_PORT=8003
DUCKDICE_WEB_DEBUG=false

# Paths (defaults usually work)
# DUCKDICE_WEB_DB_PATH=~/.duckdice_web.db
# DUCKDICE_WEB_BOT_DATA_DIR=~/.duckbot_tg
# DUCKDICE_WEB_INSTALL_DIR=~/duckdice-bot
# DUCKDICE_WEB_REPO_DIR=~/duckdice

# Service names
# DUCKDICE_WEB_SERVICE_CLI=duckdice
# DUCKDICE_WEB_SERVICE_TG=duckdice-tg
# DUCKDICE_WEB_SERVICE_WEB=duckdice-web

# Telegram (optional — for generating auth deep links)
# DUCKDICE_WEB_TG_BOT_TOKEN=
